<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Valledupar en su pulso — Mapa de eventos</title>
<meta name="description" content="Mapa de eventos institucionales y comerciales de Valledupar, actualizado automáticamente.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- ===================== BARRA SUPERIOR ===================== -->
  <header class="topbar">
    <div class="topbar__brand">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="30" height="30">
          <circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="2.2"/>
          <path d="M20 6 L20 34 M6 20 L34 20" stroke="currentColor" stroke-width="1.2" opacity="0.55"/>
          <circle cx="20" cy="20" r="4.2" fill="currentColor"/>
        </svg>
      </span>
      <div class="brand__text">
        <h1>Valledupar<span>en su pulso</span></h1>
      </div>
    </div>

    <div class="topbar__clock" id="reloj" aria-live="polite"></div>

    <div class="topbar__actions">
      <button class="btn-ghost" id="btn-lista" aria-expanded="false">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        Lista
      </button>
      <button class="btn-ghost" id="btn-qr">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM19 14h2v2h-2zM14 19h2v2h-2zM19 19h2v2h-2z"/></svg>
        QR
      </button>
    </div>
  </header>

  <!-- ===================== TECLADO DE FILTROS (firma visual) ===================== -->
  <nav class="acordeon" aria-label="Filtros por categoría">
    <button class="tecla tecla--todas is-active" data-categoria="todas">
      <span class="tecla__icono">✦</span><span class="tecla__label">Todas</span>
    </button>
    <button class="tecla" data-categoria="institucional" style="--tecla-color:#2C6E8C">
      <span class="tecla__icono">🏛️</span><span class="tecla__label">Institucional</span>
    </button>
    <button class="tecla" data-categoria="comercio" style="--tecla-color:#3E8A5B">
      <span class="tecla__icono">🛍️</span><span class="tecla__label">Comercio</span>
    </button>
    <button class="tecla" data-categoria="educacion" style="--tecla-color:#8A6D3B">
      <span class="tecla__icono">🎓</span><span class="tecla__label">Educación</span>
    </button>
    <button class="tecla" data-categoria="transporte" style="--tecla-color:#6C5B9E">
      <span class="tecla__icono">🚍</span><span class="tecla__label">Transporte</span>
    </button>
    <button class="tecla" data-categoria="seguridad" style="--tecla-color:#1E6B6B">
      <span class="tecla__icono">🚓</span><span class="tecla__label">Seguridad</span>
    </button>
    <button class="tecla" data-categoria="servicios_publicos" style="--tecla-color:#2C6E8C">
      <span class="tecla__icono">💡</span><span class="tecla__label">Servicios</span>
    </button>
    <button class="tecla" data-categoria="cultura_mercado" style="--tecla-color:#E8623D">
      <span class="tecla__icono">🥭</span><span class="tecla__label">Cultura y mercado</span>
    </button>
    <button class="tecla" data-categoria="justicia" style="--tecla-color:#5A4A6B">
      <span class="tecla__icono">⚖️</span><span class="tecla__label">Justicia</span>
    </button>
  </nav>

  <!-- ===================== MAPA ===================== -->
  <main class="mapa-envoltorio">
    <div id="mapa" role="application" aria-label="Mapa de eventos de Valledupar"></div>

    <div class="mapa-estado" id="mapa-estado">
      <span class="pulso-punto" aria-hidden="true"></span>
      <span id="mapa-estado-texto">Cargando eventos…</span>
    </div>
  </main>

  <!-- ===================== PANEL LATERAL: LISTA DE EVENTOS ===================== -->
  <aside class="panel-lista" id="panel-lista" aria-hidden="true">
    <div class="panel-lista__cabecera">
      <h2>Eventos de hoy y próximos</h2>
      <button class="cerrar" id="cerrar-lista" aria-label="Cerrar lista">✕</button>
    </div>
    <input type="search" id="buscador" class="buscador" placeholder="Buscar por nombre, entidad o lugar…">
    <div class="panel-lista__contenido" id="lista-eventos"></div>
  </aside>

  <!-- ===================== MODAL QR ===================== -->
  <div class="modal-fondo" id="modal-qr-fondo">
    <div class="modal-qr">
      <button class="cerrar" id="cerrar-qr" aria-label="Cerrar">✕</button>
      <h3>Escanea para ver el mapa</h3>
      <div id="qr-contenedor"></div>
      <p class="modal-qr__ayuda">Imprime este código en volantes, carteles o material institucional.</p>
      <button class="btn-primario" id="descargar-qr">Descargar QR para imprimir (PNG)</button>
    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
  <script src="app.js"></script>
</body>
</html>
